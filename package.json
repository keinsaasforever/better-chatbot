{
  "name": "better-chatbot",
  "version": "2.0.0",
  "private": true,
  "author": "keinsaas",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "dev:web": "turbo run dev --filter=web",
    "dev:desktop": "turbo run dev --filter=desktop",
    "dev:gateway": "turbo run dev --filter=gateway",
    "dev:turbopack": "pnpm --filter web dev:turbopack",
    "dev:https": "pnpm --filter web dev:https",
    "voice:bridge": "tsx scripts/voice-device-bridge.ts",
    "build": "turbo run build --filter=web",
    "build:web": "turbo run build --filter=web...",
    "build:desktop": "turbo run build --filter=desktop",
    "dist:desktop:mac": "pnpm --filter desktop dist:mac",
    "dist:desktop:win": "pnpm --filter desktop dist:win",
    "build:gateway": "turbo run build --filter=gateway",
    "start": "pnpm --filter web start",
    "build:local": "pnpm --filter web build:local",
    "test": "turbo run test",
    "test:watch": "pnpm --filter web test:watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:seed": "dotenv -- tsx scripts/seed-test-users.ts",
    "test:e2e:clean": "dotenv -- tsx scripts/cleanup-all-test-data.ts",
    "lint": "turbo run lint && biome lint",
    "lint:fix": "turbo run lint:fix && biome lint --write --unsafe",
    "format": "biome format --write",
    "check-types": "turbo run typecheck && tsc --noEmit",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "initial:env": "tsx scripts/initial-env.ts",
    "openai-compatiable:init": "tsx scripts/init-openai-compatiable.ts",
    "openai-compatiable:parse": "tsx scripts/parse-openai-compatiable.ts",
    "postinstall": "tsx scripts/postinstall.ts",
    "clean": "tsx scripts/clean.ts",
    "clean:next": "tsx scripts/clean.ts apps/web/.next",
    "db:generate": "pnpm --filter web db:generate",
    "db:reset": "pnpm --filter web db:reset",
    "db:push": "pnpm --filter web db:push",
    "db:migrate:artifacts": "tsx scripts/migrate-artifacts.ts",
    "db:studio": "pnpm --filter web db:studio",
    "db:migrate": "tsx scripts/db-migrate-safe.ts",
    "db:migrate:force": "tsx scripts/db-migrate.ts",
    "db:check-parity": "tsx scripts/check-schema-parity.ts",
    "db:pull": "pnpm --filter web db:pull",
    "db:check": "pnpm --filter web db:check",
    "rag:backfill-embeddings": "dotenv -- tsx scripts/backfill-document-embeddings.ts",
    "org:repair-active-workspaces": "dotenv -- tsx scripts/repair-stale-active-workspaces.ts",
    "docker-compose:up": "docker-compose -f docker/compose.yml up -d --build",
    "docker-compose:down": "docker-compose -f docker/compose.yml down",
    "docker-compose:logs": "docker-compose -f docker/compose.yml logs -f",
    "docker-compose:ps": "docker-compose -f docker/compose.yml ps",
    "docker-compose:update": "git pull && docker-compose -f docker/compose.yml up -d --build",
    "docker:pg": "docker run --name navigator-pg -e POSTGRES_PASSWORD=your_password -e POSTGRES_USER=your_username -e POSTGRES_DB=your_database_name -p 5432:5432 -d postgres",
    "docker:redis": "docker run --name navigator-redis -p 6379:6379 -d redis:7-alpine",
    "docker:app": "docker build -f docker/Dockerfile -t navigator . && docker run -p 3000:3000 -e NO_HTTPS=1 navigator",
    "prepare": "husky",
    "playwright:install": "playwright install",
    "check": "pnpm lint:fix && pnpm check-types && pnpm test",
    "e2b:template:build": "cd e2b/build && npm install --silent && npx tsx build.ts",
    "e2b:diagnose": "node scripts/e2b/diagnose.mjs",
    "e2b:smoke": "node scripts/e2b/smoke.mjs"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.56.0",
    "@types/node": "^20.19.19",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.6",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,json,mjs,ts,yaml,tsx,css}": [
      "biome format --write --no-errors-on-unmatched",
      "biome lint --write --unsafe --no-errors-on-unmatched"
    ]
  },
  "packageManager": "pnpm@10.2.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@tailwindcss/oxide",
      "electron",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "glob": "^11.1.0",
      "jws": "^4.0.1",
      "esbuild": "^0.25.0",
      "vite": "^7.3.2",
      "tar": "^7.5.11",
      "body-parser": "^2.2.1",
      "mdast-util-to-hast": "^13.2.1",
      "js-yaml": "^4.1.1",
      "fast-xml-parser": "^5.5.7",
      "kysely": "^0.28.14",
      "rollup": "^4.59.0",
      "flatted": "^3.4.2",
      "defu": "^6.1.5",
      "lodash": "^4.18.0",
      "lodash-es": "^4.18.0",
      "preact": "^10.27.3",
      "undici": "^6.24.0",
      "picomatch": "^2.3.2",
      "minimatch": "^3.1.4",
      "@isaacs/brace-expansion": "^5.0.1",
      "path-to-regexp": "^8.4.0",
      "hono": "^4.12.12",
      "@hono/node-server": "^1.19.13"
    }
  }
}
