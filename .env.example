# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the app will not start without these three.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres with the pgvector extension. `pnpm docker:pg` starts one locally,
# and the bundled compose file provides one for you.
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/better_chatbot

# Session signing key. Generate one with:
#   npx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=

# Models are served through the Vercel AI Gateway, which fronts every provider
# in the catalog (Anthropic, OpenAI, Google, Mistral, xAI, DeepSeek, Moonshot,
# and more). One key covers all of them: https://vercel.com/ai-gateway
# Not needed when deployed on Vercel: the gateway uses the deployment's OIDC
# token there.
AI_GATEWAY_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — each block turns on one feature. Everything else keeps working
# without it; the server logs which features are switched off at startup.
# ─────────────────────────────────────────────────────────────────────────────

# ── File uploads (Supabase Storage) ──────────────────────────────────────────
# Without these, chat attachments, avatars and generated images are disabled.
# Create the buckets below in your Supabase project first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Must match SUPABASE_URL. Used by the browser for resumable (TUS) uploads.
NEXT_PUBLIC_SUPABASE_URL=
# Bucket names — defaults shown.
# SUPABASE_ATTACHMENT_BUCKET=attachments
# SUPABASE_AVATAR_BUCKET=avatars
# SUPABASE_AI_GENERATED_BUCKET=ai-generated

# ── Knowledge bases (hosted RAG via Agentset) ────────────────────────────────
# Without it, knowledge bases are unavailable and project documents fall back
# to local pgvector search, which needs no extra service.
AGENTSET_API_KEY=
# AGENTSET_RETRIEVAL_MIN_SCORE=0.3
# AGENTSET_RETRIEVAL_RERANK_LIMIT=20

# ── Background jobs (Inngest) ────────────────────────────────────────────────
# Drives scheduled tasks and the project brain. `npx inngest-cli dev` needs
# neither key. Without Inngest, drive the two HTTP endpoints from your own cron
# using the shared secret below:
#   POST /api/scheduled-tasks/cron   header: X-Scheduled-Task-Auth
#   POST /api/sandbox/reaper         header: X-Scheduled-Task-Auth
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
SCHEDULED_TASK_SECRET=

# ── Resumable chat streams (Redis) ───────────────────────────────────────────
# Without it a stream ends when the viewer navigates away, and the cache is
# per-instance. `pnpm docker:redis` starts one locally.
REDIS_URL=

# ── Sandboxed code execution (E2B) ───────────────────────────────────────────
# Without it, generated code runs in the in-browser worker only.
E2B_API_KEY=
# "local" forces the browser worker even when E2B is configured.
NEXT_PUBLIC_CODE_EXECUTION_BACKEND=

# ── Web search (Exa) ─────────────────────────────────────────────────────────
EXA_API_KEY=

# ── Connected apps (Composio) ────────────────────────────────────────────────
# Lets users connect Gmail, Slack, GitHub, Notion and ~250 other apps with one
# click; Composio hosts the OAuth apps. Without it, the app list stays empty.
# Free tier: https://platform.composio.dev
COMPOSIO_API_KEY=

# ── Cockpit ──────────────────────────────────────────────────────────────────
# Every user connects their own sources (Stripe, Vercel, Revolut, Superlog,
# SEO, website analytics) inside the app; no provider key goes here. This key
# encrypts those credentials at rest. Optional: without it the key is derived
# from BETTER_AUTH_SECRET, so rotating that secret also means re-entering
# connections. Generate: openssl rand -base64 32
APP_SECRETS_KEY=

# ── Voice ────────────────────────────────────────────────────────────────────
# Realtime voice chat uses AI_GATEWAY_API_KEY above. Transcription needs its
# own key: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=
# NEXT_PUBLIC_ASSEMBLYAI_STREAMING_MODEL=universal-streaming

# ── Extra model providers ────────────────────────────────────────────────────
# TensorX (partner) is an EU-hosted, zero-retention provider reached directly
# rather than through the gateway. Optional. Key: https://tensorx.ai/
TENSORX_API_KEY=
# TENSORX_BASE_URL=https://api.tensorx.ai/v1
# Any OpenAI-compatible endpoint, as a JSON blob. Generate it with:
#   pnpm openai-compatiable:init && pnpm openai-compatiable:parse
OPENAI_COMPATIBLE_DATA=
# Local inference. Users can also connect their own Ollama or LM Studio from
# the model picker without any server configuration.
OLLAMA_BASE_URL=http://localhost:11434/api
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Browser notifications while the app is closed (Web Push) ─────────────────
# Generate a key pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Sign-in providers ────────────────────────────────────────────────────────
# Email and password sign-in works out of the box. Add OAuth if you want it.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# DISABLE_EMAIL_SIGN_IN=0
# DISABLE_SIGN_UP=0
# The first account created becomes the admin.
# DEFAULT_USER_ROLE=user

# ── Deployment ───────────────────────────────────────────────────────────────
# Public URL of this instance. Required once you are not on localhost.
# BETTER_AUTH_URL=https://chat.example.com
# NEXT_PUBLIC_BASE_URL=https://chat.example.com
# Serve over plain HTTP in local development.
# NO_HTTPS=1
# Skip migrations at boot (use after `pnpm db:push` on a fresh database).
# SKIP_DB_MIGRATE=1
# Connections per instance. Keep instances × this under your pooler's limit.
# POSTGRES_POOL_MAX=3
# Block adding MCP servers from the UI on a shared instance.
# NOT_ALLOW_ADD_MCP_SERVERS=1

# ── Observability (optional, off by default) ─────────────────────────────────
# OpenTelemetry traces and logs. Nothing is sent anywhere unless you set this.
# SUPERLOG_PUBLIC_TOKEN=
# SUPERLOG_RECORD_AI_CONTENT=0
